# TrendFlowAI Runtime A — copy to backend/.env

# Auth
JWT_SECRET=change-me-in-production

# Mongo (local bootstrap; production prefers Supabase — see supabase/migrations)
MONGO_URL=mongodb://localhost:27017
DB_NAME=trendflowai

# LLM — no Emergent lock-in
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# GOOGLE_API_KEY=   # alias accepted for Gemini
# CLAUDE_MODEL=claude-sonnet-4-20250514
# GEMINI_MODEL=gemini-2.0-flash

# Uploads (local filesystem)
TRENDFLOW_UPLOAD_DIR=/tmp/trendflow-uploads

# CORS
CORS_ORIGINS=http://localhost:3000

# Swarm Command export (Phase 1 returns 501 until wired)
SWARM_COMMAND_BASE_URL=
SWARM_COMMAND_API_KEY=

# Optional Supabase (schema in supabase/migrations/001_init.sql)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
