# TrendFlowAI Runtime A — copy to backend/.env

# Auth
JWT_SECRET=change-me-in-production

# Mongo (local bootstrap; production prefers Supabase — see supabase/migrations)
MONGO_URL=mongodb://localhost:27017
DB_NAME=trendflowai

# ---------- BYOK (Bring Your Own Key) ----------
# Per-user API keys are Fernet-encrypted at rest with this secret.
# REQUIRED in production before customers can save keys.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Or any long random string (we SHA-256-derive a Fernet key).
TRENDFLOW_KEY_ENCRYPTION_SECRET=

# Local smoke only: allow ephemeral encryption key if secret missing (keys won't survive restart)
# TRENDFLOW_ALLOW_EPHEMERAL_KEY_SECRET=true

# Dev escape hatch: if true AND user has no keys, Study/Test may fall back to env LLM keys.
# NEVER enable in production customer traffic — product lock §3d.
ALLOW_DEV_SHARED_LLM_KEYS=false

# Shared LLM keys — LOCAL SMOKE / ALLOW_DEV_SHARED_LLM_KEYS only.
# Customer Study/Test traffic uses per-user encrypted keys from Settings / onboarding step 3.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# GOOGLE_API_KEY=   # alias accepted for Gemini
# XAI_API_KEY=      # optional for Grok reason slot in local smoke
# CLAUDE_MODEL=claude-sonnet-4-20250514
# GEMINI_MODEL=gemini-2.0-flash

# Uploads (local filesystem)
TRENDFLOW_UPLOAD_DIR=/tmp/trendflow-uploads

# CORS
CORS_ORIGINS=http://localhost:3000

# Swarm Command export (Phase 1 returns 501 until wired)
SWARM_COMMAND_BASE_URL=
SWARM_COMMAND_API_KEY=

# Optional Supabase (schema in supabase/migrations/001_init.sql + 002_ai_config.sql)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
